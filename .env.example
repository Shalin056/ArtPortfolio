# Copy this file to .env for local development (python-decouple reads it automatically),
# or set these as real environment variables in your hosting provider.

# Generate one with:  python -c "from django.core.management.utils import 
#   get_random_secret_key as g; print(g())"
SECRET_KEY=replace-me-before-deploying
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave blank to use local SQLite. In production, set this to your free
# PostgreSQL connection string, e.g. from Neon (https://neon.tech):
#   postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Leave blank to store uploaded images on the local filesystem (fine for
# local dev only). In production, set this to your free Cloudinary URL
# (https://cloudinary.com) so uploads survive redeploys:
#   cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
